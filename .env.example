# Auth — generate a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=replace-me-with-a-secret-string

# SQLite database file path
DATABASE_PATH=./data/baard.db

# Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@baard.cc

# Resend template ID for login notification emails (optional — falls back to plain HTML if unset)
# In Resend dashboard: Templates → your template → copy the ID
# Available variables: {{{app_name}}}, {{{company_address}}}, {{{device}}}, {{{first_name}}},
#                      {{{ip_address}}}, {{{location}}}, {{{secure_account_url}}},
#                      {{{sign_in_time}}}, {{{support_url}}}
RESEND_LOGIN_TEMPLATE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Your company/mailing address shown in email footers
COMPANY_ADDRESS=Lisbon, Portugal

# Resend template IDs for each newsletter — used for "Send me a copy" in settings
# Available variables: {{{email}}}
RESEND_NEWSLETTER_TEMPLATE_ID_1=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RESEND_NEWSLETTER_TEMPLATE_ID_2=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx
RESEND_NEWSLETTER_TEMPLATE_ID_3=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Resend Audience IDs — create three audiences in your Resend dashboard
RESEND_AUDIENCE_ID_1=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx   # Monthly Update
RESEND_AUDIENCE_ID_2=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx   # Tech Notes
RESEND_AUDIENCE_ID_3=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx   # Life & Travel
