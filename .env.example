# Auth — generate a long random string (e.g. openssl rand -hex 32)
JWT_SECRET=replace-me-with-a-secret-string

# Email address allowed to create/edit blog posts and trigger broadcasts at /admin
ADMIN_EMAIL=you@example.com

# Google OAuth (https://console.cloud.google.com/apis/credentials)
# Authorized redirect URI must be: <your-site-url>/api/auth/google/callback
GOOGLE_CLIENT_ID=xxxxxxxxxxxx-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-xxxxxxxxxxxxxxxxxxxxxxxx

# SQLite database file path
DATABASE_PATH=./data/baard.db

# Resend (https://resend.com)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM_EMAIL=hello@baard.cc

# Resend template ID for login notification emails (optional — falls back to plain HTML if unset)
# In Resend dashboard: Templates → your template → copy the ID
# Available variables: {{{app_name}}}, {{{company_address}}}, {{{device}}}, {{{first_name}}},
#                      {{{ip_address}}}, {{{location}}}, {{{secure_account_url}}},
#                      {{{sign_in_time}}}, {{{support_url}}}
RESEND_LOGIN_TEMPLATE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Resend template ID for password reset emails (optional — falls back to plain HTML if unset)
# Available variables: {{{first_name}}}, {{{reset_url}}}, {{{support_url}}},
#                      {{{company_name}}}, {{{company_address}}}
RESEND_RESET_PASSWORD_TEMPLATE_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Your company/mailing address shown in email footers
COMPANY_ADDRESS=Lisbon, Portugal

# Resend Segment ID for blog subscribers — create a segment in your Resend dashboard
# (Contacts → Segments). Broadcasts for new posts are sent to this segment.
RESEND_BLOG_SEGMENT_ID=seg_xxxxxxxxxxxxxxxxxxxxxxxx
